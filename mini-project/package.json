{
  "name": "mini-project",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "typeorm": "typeorm",
    "migration:create": "node -r dotenv/config ./node_modules/typeorm/cli.js migration:create ./src/database/migrations/$npm_config_name --outputJs",
    "migration:generate": "node -r dotenv/config ./node_modules/typeorm/cli.js migration:generate ./src/database/migrations/$npm_config_name -d src/database/data-source.js --outputJs",
    "migration:run": "node -r dotenv/config ./node_modules/typeorm/cli.js migration:run -d src/database/data-source.js",
    "migration:revert": "node -r dotenv/config ./node_modules/typeorm/cli.js migration:revert -d src/database/data-source.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.16.2",
    "typeorm": "^0.3.25",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
